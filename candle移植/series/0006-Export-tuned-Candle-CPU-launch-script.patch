diff --git a/benchmarks/cpuprofiler/src/cpuprofiler/export.py b/benchmarks/cpuprofiler/src/cpuprofiler/export.py
new file mode 100644
index 00000000..a7d258f9
--- /dev/null
+++ b/benchmarks/cpuprofiler/src/cpuprofiler/export.py
@@ -0,0 +1,23 @@
+"""Write the fastest measured Candle configuration as a shell script."""
+
+from pathlib import Path
+import shlex
+
+from .benchmark import BenchmarkResult, execution
+
+
+def export_tuned(result: BenchmarkResult, output: Path) -> Path:
+    config = result.config
+    output = output.resolve()
+    if output in (config.binary, config.model, config.tokenizer):
+        raise ValueError("output must not overwrite the binary, model or tokenizer")
+    command, settings = execution(config, include_prompt=False)
+    lines = ["#!/usr/bin/env bash", "set -eu", ""]
+    lines += [f"export {name}={shlex.quote(value)}" for name, value in settings.items()]
+    lines += ["", 'if [ "$#" -eq 0 ]; then',
+              f"    set -- --prompt {shlex.quote(config.prompt)}", "fi",
+              "", "exec " + shlex.join(command) + ' "$@"', ""]
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text("\n".join(lines))
+    output.chmod(0o755)
+    return output
