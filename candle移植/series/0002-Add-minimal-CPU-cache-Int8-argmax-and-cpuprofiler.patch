+"""CPU-only Candle autotuning based on llama2.c's kasikoi2 search."""
+
+from .autotuner import AutoTuner
+from .benchmark import BenchmarkRunner
+from .benchmarkconfig import BenchmarkConfig
+from .topology import CPUTopology
+from pathlib import Path
+
+
+def main(argv=None):
+    import argparse
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", type=Path, default=BenchmarkConfig.binary)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--tokenizer", type=Path, required=True)
+    parser.add_argument("--group-size", type=int, default=BenchmarkConfig.group_size)
+    parser.add_argument("--no-int8", action="store_false", dest="two_stage_argmax")
+    parser.add_argument("--top-k", type=int, default=3)
+    parser.add_argument("--repeats", type=int, default=3)
+    parser.add_argument("--calibration-repeats", type=int, default=3)
+    parser.add_argument("--tolerance", type=float, default=0.05)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--timeout", type=float, default=BenchmarkConfig.timeout)
+    args = parser.parse_args(argv)
+
+    topology = CPUTopology()
+    config = BenchmarkConfig(
+        cpus=tuple(sorted(topology.cpus)), threads=topology.n_logical_cpus,
+        binary=args.binary.resolve(), model=args.model.resolve(),
+        tokenizer=args.tokenizer.resolve(), two_stage_argmax=args.two_stage_argmax,
+        group_size=args.group_size, timeout=args.timeout,
+    )
+    tuner = AutoTuner(topology, BenchmarkRunner())
+    result = tuner.kasikoi2_search(
+        config, top_k=args.top_k, repeats=args.repeats, seed=args.seed,
+        calibration_repeats=args.calibration_repeats, tolerance=args.tolerance,
+    )
+    print(f"Best CPUs: {result.config.cpus}, threads={result.config.threads}")
+    print(f"Best performance: {result.tokens_per_second:.2f} token/s")
+    print(f"Search: {tuner.last_search['seconds']:.2f} s, "
+          f"{tuner.last_search['measurements']} measurements")
