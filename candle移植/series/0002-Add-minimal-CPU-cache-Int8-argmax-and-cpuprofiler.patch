--- /dev/null
+++ b/benchmarks/cpuprofiler/src/cpuprofiler/benchmark.py
@@ -0,0 +1,40 @@
+"""Run Candle's llama2-c example on a chosen CPU layout."""
+
+from dataclasses import dataclass
+import os
+import re
+import subprocess
+
+from .benchmarkconfig import BenchmarkConfig
+
+RATE_RE = re.compile(r"\n\d+ tokens generated \(([\d.]+) token/s\)")
+
+
+@dataclass
+class BenchmarkResult:
+    config: BenchmarkConfig
+    tokens_per_second: float
+
+    @property
+    def ms_per_token(self):
+        return 1000 / self.tokens_per_second
+
+
+class BenchmarkRunner:
+    def run(self, config: BenchmarkConfig) -> BenchmarkResult:
+        mask = ",".join(map(str, config.cpus))
+        command = ["taskset", "-c", mask, str(config.binary), "--cpu",
+                   "--tokenizer", str(config.tokenizer), "--repeat-penalty", "1",
+                   "inference", "--config", str(config.model),
+                   "--temperature", "0", "--prompt", config.prompt]
+        if config.two_stage_argmax:
+            command += ["--two-stage-argmax", "--group-size", str(config.group_size)]
+        env = os.environ.copy()
+        env.update(RAYON_NUM_THREADS=str(config.threads),
+                   CANDLE_NUM_THREADS=str(config.threads), CANDLE_CPU_MASK=mask)
+        result = subprocess.run(command, env=env, capture_output=True, text=True,
+                                check=True, timeout=config.timeout)
+        match = RATE_RE.search(result.stdout)
+        if match is None:
+            raise RuntimeError(f"token/s not found in output:\n{result.stdout[-1000:]}")
+        return BenchmarkResult(config, float(match.group(1)))
