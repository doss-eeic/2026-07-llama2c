+//! Two-stage greedy argmax over the output projection, ported from the llama2.c fork
+//! (2026-07-llama2c `src/classifier.h`).
+//!
+//! Every row is first scored with group-wise int8 weights together with an error bound.
+//! Only the rows whose upper bound reaches the best lower bound are recomputed in f32, and
+//! the argmax is taken over those. This keeps the greedy choice of the f32 output layer
+//! without computing all the f32 logits.
+use anyhow::{bail, Result};
+use candle::Tensor;
+use rayon::prelude::*;
+
+pub struct Int8Classifier {
+    w: Vec<f32>,
+    q: Vec<i8>,
+    s: Vec<f32>,
+    dim: usize,
+    gs: usize,
+}
+
+const ROWS_PER_TASK: usize = 64;
+
+impl Int8Classifier {
+    /// `w` is the (vocab_size, dim) output weight, `gs` the quantization group size.
+    pub fn new(w: &Tensor, gs: usize) -> Result<Self> {
+        let (vocab, dim) = w.dims2()?;
+        if gs == 0 || dim % gs != 0 {
+            bail!("group size {gs} must divide the model dim {dim}")
+        }
+        let w = w.flatten_all()?.to_vec1::<f32>()?;
+        let ng = dim / gs;
+        let mut q = vec![0i8; vocab * dim];
+        let mut s = vec![0f32; vocab * ng];
+        q.par_chunks_mut(dim)
+            .zip(s.par_chunks_mut(ng))
+            .zip(w.par_chunks(dim))
+            .for_each(|((q, s), w)| {
+                for g in 0..ng {
+                    let w = &w[g * gs..(g + 1) * gs];
+                    let wmax = w.iter().fold(0f32, |m, v| m.max(v.abs()));
+                    let scale = wmax / 127.0;
+                    s[g] = scale;
+                    for (q, w) in q[g * gs..(g + 1) * gs].iter_mut().zip(w) {
+                        *q = if scale > 0.0 {
+                            (w / scale).round() as i8
+                        } else {
+                            0
+                        };
+                    }
+                }
+            });
+        Ok(Self { w, q, s, dim, gs })
+    }
+
+    /// Returns the index of the largest f32 logit for the hidden state `x` (length dim).
+    pub fn argmax(&self, x: &[f32]) -> u32 {
+        let (dim, gs) = (self.dim, self.gs);
+        let ng = dim / gs;
+        let a: Vec<f32> = x
+            .chunks(gs)
+            .map(|x| x.iter().map(|v| v.abs()).sum())
+            .collect();
+        // (upper bound, lower bound) of every row.
+        let bounds: Vec<(f32, f32)> = candle::utils::with_threadpool(|| {
+            self.q
+                .par_chunks(dim * ROWS_PER_TASK)
+                .zip(self.s.par_chunks(ng * ROWS_PER_TASK))
+                .flat_map_iter(|(q, s)| {
+                    q.chunks(dim).zip(s.chunks(ng)).map(|(q, s)| {
+                        let mut approx = 0f32;
+                        let mut bound = 0f32;
+                        for g in 0..ng {
+                            let mut dot = 0f32;
+                            for (q, x) in q[g * gs..(g + 1) * gs].iter().zip(&x[g * gs..]) {
+                                dot += *q as f32 * x;
+                            }
+                            approx += dot * s[g];
+                            bound += s[g] * a[g];
+                        }
+                        // Same rounding margin as the C implementation.
+                        let err = 0.51 * bound + 1e-6;
+                        (approx + err, approx - err)
+                    })
+                })
+                .collect()
+        });
+        let lo = bounds.iter().fold(f32::MIN, |m, b| m.max(b.1));
+        let mut best = (0u32, f32::MIN);
+        for (i, b) in bounds.iter().enumerate() {
+            if b.0 < lo {
+                continue;
+            }
+            let w = &self.w[i * dim..(i + 1) * dim];
+            let mut v = 0f32;
+            for (w, x) in w.iter().zip(x) {
+                v += w * x;
+            }
+            if v > best.1 {
+                best = (i as u32, v);
+            }
+        }
+        best.0
+    }
+}
