# Python bytecode, environments, and tool caches
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
/dist/

# Native build outputs; keep the existing shared model fixture
/runq
/testc
*.exe
*.o
*.obj
*.pdb
*.ilk
*.dSYM/

# Local benchmark runs
/benchmark/
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite3.lock

# Downloaded datasets, training outputs, and test checkpoints
/data/
/out/
/test/
.ipynb_checkpoints/

# Local environment settings and operating-system files
.env
.env.*
!.env.example
!.env.sample
.DS_Store
Thumbs.db

# Local scratch work and benchmark results
/tmp/
/results/

# Build executables and model fixtures are intentionally versioned.
# Keep this exception after extension-based ignore rules (e.g. *.exe).
!/build/
!/build/**

# Machine-specific autotuning exports
/build/run-tuned.sh
